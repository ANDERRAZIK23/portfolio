{
  "name": "portfolio-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev",
    "check": "node --check src/index.js && node --check public/admin.js",
    "build:check": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir .dry-run",
    "test": "node --test test/*.test.js",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply portfolio-analytics --remote"
  },
  "dependencies": { "jose": "6.2.13" },
  "devDependencies": { "wrangler": "4.152.0" }
}
