{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-admin-local",
  "main": "src/local.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "SITE_ORIGIN": "https://imachraf.tech" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "portfolio-analytics-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "portfolio-private-files-local" }],
  "ratelimits": [{ "name": "COLLECT_LIMITER", "namespace_id": "17032301", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": false }
}
